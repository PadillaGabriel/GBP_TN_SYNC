APP_NAME=Integrador GBP TN
APP_ENV=local
APP_DEBUG=true
APP_PUBLIC_BASE_URL=
DATABASE_URL=

GBP_BASE_URL=http://ws.globalbluepoint.com/silmarbazar/app_webservices/wsBasicQuery.asmx
GBP_USERNAME=
GBP_PASSWORD=
GBP_COMPANY_ID=
GBP_WEB_SERVICE_ID=1000
GBP_TIMEOUT_SECONDS=20
GBP_RETRY_ATTEMPTS=2
GBP_MODULE16_STRICT=true

TIENDA_NUBE_STORE_ID=
TIENDA_NUBE_ACCESS_TOKEN=
TIENDA_NUBE_BASE_URL=https://api.tiendanube.com/v1
TIENDA_NUBE_TIMEOUT_SECONDS=20
TIENDA_NUBE_USER_AGENT=IntegradorGBP-TN/1.0
TIENDA_NUBE_WEBHOOK_SECRET=
# Por seguridad, el flujo automático se activa normalmente al confirmar el pago.
TIENDA_NUBE_WEBHOOK_EVENTS=order/paid
TIENDA_NUBE_PEDIDOS_AUTOMATICOS_HABILITADOS=false

ONLINE_PRICE_LIST_ID=
ECOMMERCE_STORAGE_IDS=1

STOCK_SCHEDULER_ENABLED=false
STOCK_SYNC_INTERVAL_MINUTES=10
STOCK_SYNC_BATCH_SIZE=50
STOCK_SYNC_CONCURRENCY=5

IMPORT_SCHEDULER_ENABLED=false
PRODUCT_AUDIT_INTERVAL_HOURS=24

DRY_RUN=true
LOG_LEVEL=INFO

GBP_DIAGNOSTIC_SKU=
GBP_DIAGNOSTIC_ITEM_ID=
GBP_DIAGNOSTIC_STORAGE_ID=
GBP_DIAGNOSTIC_PRICE_LIST_ID=

# Pedidos: la escritura real en GBP permanece deshabilitada hasta completar la validación controlada en el entorno real.
PEDIDOS_ESCRITURA_GBP_HABILITADA=false

# Configuración comercial para pedidos Tienda Nube -> GBP (solo lectura por defecto)
PEDIDOS_GBP_COMPANY_ID=1
PEDIDOS_GBP_BRANCH_ID=28
PEDIDOS_GBP_PROFILE_ID=1
PEDIDOS_GBP_STORAGE_ID=18
PEDIDOS_GBP_PRICE_LIST_ID=4
PEDIDOS_GBP_SALESMAN_ID=10
PEDIDOS_GBP_SALES_TERMS_ID=20
PEDIDOS_GBP_CURRENCY_ID=1
PEDIDOS_GBP_ORDER_TYPE_ID=1
PEDIDOS_GBP_TRANSACTION_ID=1
PEDIDOS_GBP_TRANSACTION_CLASS=A
PEDIDOS_GBP_INITIAL_STATUS_ID=50
PEDIDOS_GBP_INVOICE_A_DOCUMENT_ID=98
PEDIDOS_GBP_INVOICE_B_DOCUMENT_ID=145

PEDIDOS_GBP_CUSTOMER_COUNTRY_ID=54
PEDIDOS_GBP_CUSTOMER_FISCAL_CLASS_ID=2
PEDIDOS_GBP_SALE_ORDER_BASE_URL=https://ws.globalbluepoint.com/silmarbazar/app_webservices/wsSaleOrder.asmx
PEDIDOS_GBP_LANGUAGE_ID=2
PEDIDOS_GBP_DELIVERY_ID=1
PEDIDOS_GBP_DISCOUNT_ID=1
PEDIDOS_GBP_SHIPPING_ITEM_ID=7774
PEDIDOS_GBP_SHIPPING_SPECIAL_QTY=1
PEDIDOS_GBP_DISCOUNT_ITEM_CODE=CUPON
PEDIDOS_GBP_DISCOUNT_SPECIAL_QTY=-1
PEDIDOS_GBP_STAGING_ENABLED=false
PEDIDOS_GBP_CONFIRMATION_ENABLED=false

PEDIDOS_GBP_TOTAL_TOLERANCE=0.01
PEDIDOS_GBP_RESIDUAL_MAXIMO_AJUSTABLE=0.05

# Precios de pedidos GBP: Tiendanube entrega importes finales con IVA y wsSaleOrder recibe netos.
PEDIDOS_GBP_PRICES_INCLUDE_VAT=true
PEDIDOS_GBP_DEFAULT_VAT_RATE=21
# Overrides opcionales por SKU, articulo auxiliar o codigo: {"SKU":10.5,"ENVIO":21,"CUPON":21}
PEDIDOS_GBP_VAT_RATE_OVERRIDES=

# Exportaciones Personalizadas GBP
GBP_EXPORT_PRODUCTO_POR_ITEM_ID=11
GBP_EXPORT_PRODUCTOS_GENERAL_ID=12
GBP_EXPORT_PRODUCTOS_PRECIOS_ID=13
GBP_EXPORT_PRODUCTOS_STOCK_ID=14
GBP_EXPORT_CACHE_SECONDS=120
ONLINE_PRICE_LIST_ID=4
ECOMMERCE_STORAGE_IDS=18
